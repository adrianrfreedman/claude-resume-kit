<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>you.job-tracker.check</string>

  <key>ProgramArguments</key>
  <array>
    <string>/path/to/claude-resume-kit/job_scanner/launchd/run-tracker.sh</string>
    <string>check</string>
  </array>

  <key>StartInterval</key>
  <integer>300</integer>

  <key>StandardOutPath</key>
  <string>/path/to/claude-resume-kit/job_scanner/state/tracker/launchd.check.out.log</string>

  <key>StandardErrorPath</key>
  <string>/path/to/claude-resume-kit/job_scanner/state/tracker/launchd.check.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/you</string>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>/path/to/claude-resume-kit</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
